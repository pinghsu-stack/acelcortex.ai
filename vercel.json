{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/start-here",
      "destination": "/start",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/starthere",
      "destination": "/start"
    }
  ]
}
